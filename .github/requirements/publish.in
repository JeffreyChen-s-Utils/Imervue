# The two jobs that hold the PyPI token build and upload with these: the release job of release.yml and
# the publish-dev job of test.yml. publish.txt is generated from this file:
#   uv pip compile .github/requirements/publish.in --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 --only-binary :all: --exclude-newer 2026-09-24 -o .github/requirements/publish.txt
# --python-version is the one both jobs set up. --exclude-newer leaves out anything uploaded in the
# last seven days: move the date when regenerating.
build==1.5.0
twine==7.0.0
# The build backend. The jobs run `python -m build --no-isolation`, so the backend is this locked one and
# not whatever is newest on PyPI when the job runs. It must satisfy `build-system.requires` in
# pyproject.toml and dev.toml (tests/test_workflow_actions.py).
setuptools
